<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         version="4.0">

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.sunrise.dental.controller.LoginServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UserServlet</servlet-name>
        <servlet-class>com.sunrise.dental.controller.UserServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>UserServlet</servlet-name>
        <url-pattern>/admin/users/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TreatmentServlet</servlet-name>
        <servlet-class>com.sunrise.dental.controller.TreatmentServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>TreatmentServlet</servlet-name>
        <url-pattern>/admin/treatments/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AppointmentServlet</servlet-name>
        <servlet-class>com.sunrise.dental.controller.AppointmentServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AppointmentServlet</servlet-name>
        <url-pattern>/patient/appointments/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PaymentServlet</servlet-name>
        <servlet-class>com.sunrise.dental.controller.PaymentServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>PaymentServlet</servlet-name>
        <url-pattern>/receptionist/payment</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PatientServlet</servlet-name>
        <servlet-class>com.sunrise.dental.controller.PatientServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>PatientServlet</servlet-name>
        <url-pattern>/receptionist/patients</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>PatientServlet</servlet-name>
        <url-pattern>/admin/patients</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DentistAppointmentServlet</servlet-name>
        <servlet-class>com.sunrise.dental.controller.DentistAppointmentServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>DentistAppointmentServlet</servlet-name>
        <url-pattern>/dentist/appointments</url-pattern>
    </servlet-mapping>


</web-app>
